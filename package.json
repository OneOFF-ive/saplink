{
  "name": "saplink",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "description": "Local HTTP MCP server for SAP ABAP development",
  "bin": {
    "saplink": "dist/cli.js"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/cli.js",
    "dev": "node --import tsx src/cli.ts",
    "pretest": "npm run build",
    "package:windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File packaging/windows/build.ps1",
    "release:windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File packaging/windows/release.ps1",
    "test:installer": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File packaging/windows/smoke-test.ps1",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "abap-adt-api": {
      "sprintf-js": "file:../../vendor/adt-path-format"
    }
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "abap-adt-api": "8.5.0",
    "axios": "1.20.0",
    "commander": "15.0.0",
    "express": "5.3.0",
    "fast-xml-parser": "5.11.2",
    "lucide": "1.57.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
